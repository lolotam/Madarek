# Copy to .env.local for local use. In Dokploy, set these under the
# application's Environment tab (see docs/DEPLOYMENT.md). Never commit values.

# Public URL of the site. Required in production behind a proxy: it pins the
# origin check for form submissions and makes the session cookie Secure.
# Example: https://madarek.cc
APP_ORIGIN=

# 32-byte AES-256-GCM master key as base64 or 64 hex chars. Required to store
# API secrets from the admin dashboard. Generate once and keep it: changing it
# makes stored secrets unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Optional. The Docker image sets these to /app/.data/...; locally they default
# to .data/learning.sqlite and .data/audio.
DATABASE_PATH=
AUDIO_LIBRARY_PATH=
# Optional. Defaults to src/server/narration.
NARRATION_DIR=

# ElevenLabs. Optional here: admin dashboard settings take precedence and are
# stored encrypted. Never use a NEXT_PUBLIC_ prefix for the key.
ELEVENLABS_API_KEY=
# Voice id from the ElevenLabs dashboard. Required for generate.
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2 when unset.
ELEVENLABS_MODEL_ID=
# Optional. Defaults to mp3_44100_128 when unset.
ELEVENLABS_OUTPUT_FORMAT=
# Integer cap on characters sent in one generate run. No default; generate
# refuses without it. The full Nutrients library needs about 8,200.
ELEVENLABS_MAX_CHARACTERS=
