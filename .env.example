# ElevenLabs API key. Never use a NEXT_PUBLIC_ prefix. Leave empty here.
ELEVENLABS_API_KEY=
# Voice id from the ElevenLabs dashboard. Required for generate.
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2 when unset.
ELEVENLABS_MODEL_ID=
# Optional. Defaults to mp3_44100_128 when unset.
ELEVENLABS_OUTPUT_FORMAT=
# Integer cap on characters sent in one generate run. No default; generate refuses without it.
ELEVENLABS_MAX_CHARACTERS=
# 32-byte AES-256-GCM master key as base64 or 64 hex chars. Required to store API secrets.
# Leave empty here; set a real value in .env.local. Never commit a real key.
SETTINGS_ENCRYPTION_KEY=
# Optional. Defaults to .data/audio when unset.
AUDIO_LIBRARY_PATH=
# Optional. Defaults to src/server/narration when unset.
NARRATION_DIR=
